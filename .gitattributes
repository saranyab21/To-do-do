# Normalise line endings in the repo; check out native endings locally.
* text=auto

*.py      text eol=lf
*.sh      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.tex     text eol=lf
*.bib     text eol=lf
*.ipynb   text eol=lf
*.bat     text eol=crlf
*.ps1     text eol=crlf

*.png     binary
*.jpg     binary
*.pdf     binary
*.pptx    binary
*.docx    binary
